# Copy this file to .env and adjust values.
# NEVER commit .env — real credentials live only on your machine.

# --- Warehouse (docker-compose) ---
POSTGRES_USER=lifebase
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=lifebase

# --- Connection used by dlt / dbt / MCP / Streamlit ---
LIFEBASE_DB_URI=postgresql://lifebase:change_me_local_only@localhost:5432/lifebase

# --- Source credentials (fill per pipeline) ---
GITHUB_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# --- Agent ---
ANTHROPIC_API_KEY=
